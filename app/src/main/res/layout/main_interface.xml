<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".main_interface">
    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/fragment_manage"
        android:layout_height="600dp">
        <fragment
            android:layout_width="match_parent"
            android:id="@+id/qiehuan"
            android:name="com.example.myapplication.fragment.fragment_me"
            tools:layout="@layout/fragment_me"
            android:layout_height="match_parent"
            >
        </fragment>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <ImageView
            android:id="@+id/search_for_icon"
            android:layout_width="0dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/search_for_icon"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <ImageView
            android:id="@+id/fragment_two_icon"
            android:layout_width="0dp"
            android:layout_marginLeft="10dp"
            android:layout_height="match_parent"
            android:src="@drawable/fragment_two_icon"
            android:layout_weight="1" />
<!--        <ImageView-->
<!--            android:id="@+id/fragment_three_icon"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_marginLeft="10dp"-->
<!--            android:layout_height="match_parent"-->
<!--            android:src="@drawable/fragment_three_icon"-->
<!--            android:layout_weight="1" />-->
        <ImageView
            android:id="@+id/fragment_me_icon"
            android:layout_width="0dp"
            android:layout_marginLeft="10dp"
            android:layout_height="match_parent"
            android:background="@color/green"
            android:src="@drawable/fragment_me_icon"
            android:layout_weight="1" />

    </LinearLayout>









</LinearLayout>